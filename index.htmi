<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI 운동 도우미</title>
  <style>
    :root {
      --primary-color: #2563eb;
      --bg-color: #f8fafc;
      --chat-bg: #ffffff;
      --user-msg: #2563eb;
      --bot-msg: #f1f5f9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .chat-container {
      width: 100%;
      max-width: 500px;
      height: 700px;
      background: var(--chat-bg);
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .header {
      background: var(--primary-color);
      color: white;
      padding: 16px 20px;
      text-align: center;
    }

    .header h1 {
      font-size: 1.2rem;
      margin-bottom: 4px;
    }

    .header p {
      font-size: 0.8rem;
      opacity: 0.9;
    }

    .api-key-container {
      padding: 12px 16px;
      background: #eff6ff;
      border-bottom: 1px solid #dbeafe;
      display: flex;
      gap: 8px;
    }

    .api-key-container input {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid #bfdbfe;
      border-radius: 8px;
      font-size: 0.85rem;
      outline: none;
    }

    .api-key-container button {
      padding: 8px 14px;
      background: var(--primary-color);
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .chat-box {
      flex: 1;
      padding: 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .message {
      max-width: 80%;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.95rem;
      line-height: 1.4;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .user-message {
      align-self: flex-end;
      background: var(--user-msg);
      color: white;
      border-bottom-right-radius: 2px;
    }

    .bot-message {
      align-self: flex-start;
      background: var(--bot-msg);
      color: #1e293b;
      border-bottom-left-radius: 2px;
    }

    .system-message {
      align-self: center;
      background: #fef3c7;
      color: #92400e;
      font-size: 0.8rem;
      padding: 6px 12px;
      border-radius: 20px;
    }

    .input-container {
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      gap: 8px;
    }

    .input-container input {
      flex: 1;
      padding: 10px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 20px;
      outline: none;
      font-size: 0.95rem;
    }

    .input-container button {
      padding: 10px 18px;
      background: var(--primary-color);
      color: white;
      border: none;
      border-radius: 20px;
      cursor: pointer;
      font-weight: 600;
    }

    .input-container button:disabled {
      background: #94a3b8;
      cursor: not-allowed;
    }
  </style>

  <!-- Google GenAI SDK 스크립트 모듈 로드 -->
  <script type="importmap">
    {
      "imports": {
        "@google/genai": "https://esm.run/@google/genai"
      }
    }
  </script>
</head>
<body>

  <div class="chat-container">
    <div class="header">
      <h1>🏋️‍♂️ AI 운동 도우미</h1>
      <p>맞춤형 루틴 추천부터 자세 및 영양 조언까지!</p>
    </div>

    <!-- API 키 입력 영역 -->
    <div class="api-key-container">
      <input type="password" id="apiKeyInput" placeholder="Google Gemini API 키 입력" />
      <button id="saveKeyBtn">저장</button>
    </div>

    <!-- 대화 출력 영역 -->
    <div class="chat-box" id="chatBox">
      <div class="message system-message">
        API 키를 입력하고 운동에 관해 무엇이든 물어보세요!
      </div>
    </div>

    <!-- 메시지 입력 영역 -->
    <div class="input-container">
      <input type="text" id="userInput" placeholder="예: 초보자용 3분할 운동 루틴 추천해줘" disabled />
      <button id="sendBtn" disabled>전송</button>
    </div>
  </div>

  <script type="module">
    import { GoogleGenAI } from "@google/genai";

    let apiKey = "";
    let chatSession = null;

    const apiKeyInput = document.getElementById("apiKeyInput");
    const saveKeyBtn = document.getElementById("saveKeyBtn");
    const userInput = document.getElementById("userInput");
    const sendBtn = document.getElementById("sendBtn");
    const chatBox = document.getElementById("chatBox");

    // 저장된 API 키 확인
    const savedKey = localStorage.getItem("GEMINI_API_KEY");
    if (savedKey) {
      apiKeyInput.value = savedKey;
      initChat(savedKey);
    }

    // API 키 저장 및 초기화
    saveKeyBtn.addEventListener("click", () => {
      const key = apiKeyInput.value.trim();
      if (!key) {
        alert("올바른 API 키를 입력하세요.");
        return;
      }
      localStorage.setItem("GEMINI_API_KEY", key);
      initChat(key);
      addMessage("system", "API 키가 성공적으로 설정되었습니다.");
    });

    // 챗봇 세션 생성
    function initChat(key) {
      apiKey = key;
      try {
        const ai = new GoogleGenAI({ apiKey: apiKey });
        
        // chats.create로 세션 생성 및 운동 도우미 컨셉(systemInstruction) 부여
        chatSession = ai.chats.create({
          model: "gemini-2.5-flash",
          config: {
            systemInstruction: `당신은 전문적이고 동기부여를 잘 해주는 친절한 'AI 운동 도우미' 트레이너입니다. 
- 운동 방법, 맞춤형 운동 루틴, 근육 부위별 가이드, 운동 영양 및 식단 관리에 대한 조언을 제공합니다.
- 답변은 가독성 좋고 명확하게 작성하며, 격려와 응원의 톤을 유지하세요.
- 질문자가 안전하게 운동할 수 있도록 부상 예방 지침을 항상 유념하세요.`
          }
        });

        userInput.disabled = false;
        sendBtn.disabled = false;
      } catch (err) {
        console.error(err);
        alert("챗봇 초기화 실패: API 키를 다시 확인하세요.");
      }
    }

    // 화면에 메시지 추가
    function addMessage(sender, text) {
      const msgDiv = document.createElement("div");
      msgDiv.classList.add("message");

      if (sender === "user") {
        msgDiv.classList.add("user-message");
      } else if (sender === "bot") {
        msgDiv.classList.add("bot-message");
      } else {
        msgDiv.classList.add("system-message");
      }

      msgDiv.textContent = text;
      chatBox.appendChild(msgDiv);
      chatBox.scrollTop = chatBox.scrollHeight;
      return msgDiv;
    }

    // 메시지 전송 로직
    async function handleSend() {
      const text = userInput.value.trim();
      if (!text || !chatSession) return;

      addMessage("user", text);
      userInput.value = "";
      userInput.disabled = true;
      sendBtn.disabled = true;

      const botMessageDiv = addMessage("bot", "생각 중...");

      try {
        const response = await chatSession.sendMessage({ message: text });
        botMessageDiv.textContent = response.text;
      } catch (error) {
        console.error(error);
        botMessageDiv.textContent = "오류가 발생했습니다. API 키나 네트워크 상태를 확인해 주세요.";
      } finally {
        userInput.disabled = false;
        sendBtn.disabled = false;
        userInput.focus();
      }
    }

    sendBtn.addEventListener("click", handleSend);
    userInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") handleSend();
    });
  </script>

</body>
</html>